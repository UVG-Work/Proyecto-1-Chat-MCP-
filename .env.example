# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pick a model that supports tool calling.
# Filter available ones at: https://openrouter.ai/models?supported_parameters=tools
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Optional attribution headers sent to OpenRouter
OPENROUTER_APP_TITLE=MCP Chat Host - UVG CC3067
OPENROUTER_APP_URL=https://github.com/UVG-Work/Proyecto-1-Chat-MCP-

# Port for the local HTTP (Streamable HTTP) instance of the NOC MCP server
NOC_HTTP_PORT=8787

# Port for the Express bridge that backs the web UI
API_PORT=3001

# Set to 1 to export TLS session keys for Wireshark decryption (requirement 7)
MCP_TLS_KEYLOG=0
